  "lines": [
   "def _agc(env, prior_lo, prior_hi, rmin_frac):",
   "    \"\"\"emg_agc.apply_agc with a configurable minimum range (same algorithm).\"\"\"",
   "    rmin = rmin_frac * np.maximum(prior_hi - prior_lo, 1e-3)",
   "    lo, hi = emg_agc._running_lo_hi(env, prior_lo, prior_hi)",
   "    clean, n_bad = env.copy(), 0",
   "    for k in range(env.shape[1]):",
   "        clean[:, k], n = emg_agc._despike(env[:, k], lo[:, k], np.maximum(hi[:, k] - lo[:, k], rmin[k]))",
   "        n_bad += n",
   "    if n_bad:",
   "        lo, hi = emg_agc._running_lo_hi(clean, prior_lo, prior_hi)",
   "    return np.clip((clean - lo) / np.maximum(hi - lo, rmin[None, :]), 0.0, emg_agc.CLIP_HI)"
  ],
  "sha256": "39b8782769da762c00d701cdc6acd824b067aa7abc1c4fe5e20b58e400db141d"
 },
 "despike": {
  "root": "d01",
  "path": "ML/preprocessing/emg_agc.py",
  "first": 66,
  "last": 72,
  "lines": [
   "def _despike(x, lo, rng):",
   "    \"\"\"Sample-and-hold over artefacts: x far above the running range, or a",
   "    drop-out far below a clearly non-zero floor.  Causal.\"\"\"",
   "    bad = ((x - lo) / rng > SPIKE_THR) | ((x < 0.25 * lo) & (lo > 0.1))",
   "    if not bad.any():",
   "        return x, 0",
   "    y, last, hold, cnt = x.copy(), lo[0], 0, 0"
  ],
  "sha256": "ea402d6cb90c637b32ff4c06b210e3bffc9a29e12aeb39c6ca07f698050b7781"
 },
