   "        u_product_t_1 = u_product_t * u_t_1",
   "        beta_2_power = ops.power(beta_2, local_step)",
   "",
   "        m = self._momentums[self._get_variable_index(variable)]",
   "        v = self._velocities[self._get_variable_index(variable)]",
